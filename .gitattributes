# Bestanden waar alleen regels bij komen. Draaien er twee runs tegelijk, dan
# kan git beide aanvullingen houden in plaats van een conflict te melden. Zonder
# dit liep de rebase vast op woz.txt en ging een hele run verloren (27-09-2026).
#
# Let op: de samenvoeger "union" is ingebouwd in git. Definieer hem niet zelf in
# de workflow; dan overschrijf je de ingebouwde en verdwijnt juist een van de
# twee kanten.
verkopen.txt merge=union
woz.txt merge=union
huidige_huur.txt merge=union
bouwkosten_eigen.txt merge=union
kamernet_plak.txt merge=union
funda_verkocht_plak.txt merge=union
onderwerpen_volgen.txt merge=union

# Bestanden die twee workflows tegelijk aanvullen, met een eigen samenvoeger.
# De samenvoeger staat in het script zelf en wordt in elke workflow die het
# bestand terugcommit aangezet met:
#   git config merge.bag3d.driver "python3 bag3d.py --samenvoegen %O %A %B"
# Zonder die regel valt git terug op gewoon samenvoegen en zet de brief bij een
# botsing zijn eigen versie neer; dan verdwijnt het werk van de inhaalslag.
bag3d.json merge=bag3d
